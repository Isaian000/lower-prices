      "html": "<a class=\"ds-label\" href=\"#\"><span class=\"ds-label-body\"><span class=\"ds-store\">Tienda B <svg viewBox=\"0 0 12 12\" class=\"ds-outbound\" aria-hidden=\"true\"><path d=\"M4 2.5h5.5V8M9.25 2.75 2.75 9.25\"/></svg></span><span class=\"ds-price\"><span class=\"ds-currency\">$</span>12,499</span><span class=\"ds-msi\">12 MSI de $1,041.58</span></span></a>",
      "css": ".ds-label{display:grid;grid-template-rows:auto 1fr;width:14rem;background:var(--paper,#fff);border:1px solid var(--rule,#dededa);border-radius:var(--radius,4px);color:var(--ink,#111);text-decoration:none;overflow:hidden;font-family:var(--font-sans,'Public Sans Variable',Arial,sans-serif);transition:border-color 160ms ease,transform 120ms cubic-bezier(0.23,1,0.32,1)}.ds-label:hover{border-color:var(--ink,#111)}.ds-label:active{transform:scale(0.98)}.ds-label:focus-visible{outline:2px solid var(--ink,#111);outline-offset:2px}.ds-label-body{display:grid;gap:0.125rem;padding:0.75rem 1rem 1rem}.ds-store{display:inline-flex;align-items:center;gap:0.25rem;font-size:0.875rem;font-weight:600;color:var(--ink-muted,#5e5e5e)}.ds-outbound{width:0.625rem;height:0.625rem;fill:none;stroke:currentColor;stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round}.ds-price{font-size:clamp(1.375rem,1.2rem + 0.6vw,1.625rem);font-weight:700;line-height:1.15;letter-spacing:-0.015em;font-variant-numeric:tabular-nums;white-space:nowrap}.ds-currency{margin-right:0.06em;font-size:0.62em;vertical-align:0.42em}.ds-msi{font-size:0.8125rem;font-weight:600}.ds-band{display:block;padding:0.25rem 1rem;background:var(--best,#ffd60a);color:var(--best-ink,#111);font-size:0.8125rem;font-weight:700}.ds-label[data-best]{border-color:var(--ink,#111)}.ds-label[data-best] .ds-store{color:var(--ink,#111)}"
    },
